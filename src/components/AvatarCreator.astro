---
import { PART_CATEGORIES, PART_ITEMS_MAP } from '../lib/avatar-data';
import { PALETTE_PRESETS } from '../lib/palettes';
---

<div class="page-container">
  <!-- 頂部 8-Bit 系統導覽列 (純黑灰白像素風格) -->
  <header class="topbar">
    <a href={import.meta.env.BASE_URL} class="brand-link">
      <div class="brand-logo-box" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 16 16" fill="none" shape-rendering="crispEdges">
          <rect x="1" y="1" width="14" height="14" fill="#141414" />
          <rect x="2" y="2" width="12" height="12" fill="#FFFFFF" />
          <rect x="3" y="3" width="10" height="2" fill="#141414" />
          <rect x="4" y="6" width="2" height="3" fill="#141414" />
          <rect x="10" y="6" width="2" height="3" fill="#141414" />
          <rect x="5" y="11" width="6" height="2" fill="#141414" />
        </svg>
      </div>
      <div class="brand-text-wrap">
        <span class="brand-title">8-BIT 頭像製作</span>
        <span class="brand-sub tabular-nums">SYS.32×32 // MONO-OS</span>
      </div>
    </a>

    <div class="topbar-meta">
      <span class="color-badge tabular-nums" id="header-color-badge">MODE: 1-BIT MONO</span>
    </div>
  </header>

  <!-- 核心單欄置中工作區 (對齊 notion-avatar.app 結構，全站黑灰白 8-Bit 視窗介面) -->
  <main class="creator-main">
    <!-- 1. 正中央 8-Bit 像素監視器預覽視窗 -->
    <div class="avatar-stage-wrap">
      <div class="pixel-window-frame">
        <div class="pixel-window-titlebar" aria-hidden="true">
          <span class="win-square-box"></span>
          <span class="win-scanlines"></span>
          <span class="win-title-label tabular-nums">SPRITE_32×32.BMP</span>
          <span class="win-scanlines"></span>
          <span class="win-coord-tag tabular-nums">1:1</span>
        </div>
        <div class="avatar-preview-box">
          <canvas
            id="main-avatar-canvas"
            class="pixel-canvas main-avatar-canvas"
            width="512"
            height="512"
            aria-label="8-Bit 像素大頭照預覽"
          ></canvas>
        </div>
      </div>
    </div>

    <!-- 2. 「請選擇一種風格」工具列 ＋ 10 大獨立部位選擇器 -->
    <section class="picker-section" aria-label="頭像部位與色系選擇">
      <div class="toolbar-row">
        <h1 class="section-prompt">請選擇一種風格</h1>

        <div class="tool-trigger-group">
          <!-- 水平翻轉按鈕 (8-Bit 像素圖示) -->
          <button
            type="button"
            class="icon-tool-btn"
            id="btn-flip-x"
            title="水平翻轉"
            aria-label="水平翻轉"
            aria-pressed="false"
          >
            <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor" shape-rendering="crispEdges">
              <!-- 中央虛線軸 -->
              <rect x="7" y="1" width="2" height="2" />
              <rect x="7" y="5" width="2" height="2" />
              <rect x="7" y="9" width="2" height="2" />
              <rect x="7" y="13" width="2" height="2" />
              <!-- 左側像素三角 -->
              <rect x="4" y="4" width="2" height="8" />
              <rect x="2" y="6" width="2" height="4" />
              <rect x="1" y="7" width="1" height="2" />
              <!-- 右側像素三角 -->
              <rect x="10" y="4" width="2" height="8" />
              <rect x="12" y="6" width="2" height="4" />
              <rect x="14" y="7" width="1" height="2" />
            </svg>
          </button>

          <!-- 色系調配按鈕 (對應 8-bit_3.jpg 黑白 vs 8-bit_2.jpg 使用者顏色自動搭配) -->
          <div class="palette-dropdown-anchor">
            <button
              type="button"
              class="icon-tool-btn palette-trigger-btn"
              id="btn-toggle-palette"
              title="色系調配"
              aria-label="色系調配"
              aria-expanded="false"
            >
              <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor" shape-rendering="crispEdges">
                <!-- 8-Bit 像素調色盤圖示 -->
                <rect x="4" y="2" width="8" height="2" />
                <rect x="2" y="4" width="2" height="8" />
                <rect x="12" y="4" width="2" height="6" />
                <rect x="4" y="12" width="6" height="2" />
                <rect x="9" y="10" width="3" height="2" />
                <!-- 色盤孔點 -->
                <rect x="5" y="5" width="2" height="2" />
                <rect x="9" y="5" width="2" height="2" />
                <rect x="5" y="9" width="2" height="2" />
              </svg>
              <span class="palette-dot-indicator" id="palette-dot-indicator"></span>
            </button>

            <!-- 色系調配彈出面板 (8-Bit 視窗框體) -->
            <div class="palette-popover is-hidden" id="palette-popover" role="dialog" aria-label="色系調配設定">
              <div class="popover-header">
                <strong>[ 色系調配 // 4-TONE PALETTE ]</strong>
                <button type="button" class="close-popover-btn" id="btn-close-palette" aria-label="關閉色系面板">✕</button>
              </div>

              <p class="popover-hint">
                預設為黑白線稿；選擇任意顏色後，系統會自動依您的顏色推算 4 階深淺進行搭配。
              </p>

              <!-- 使用者自選顏色 (Color Picker) + 恢復黑白按鈕 -->
              <div class="user-color-row">
                <label class="user-color-picker-btn" for="input-user-color">
                  <input type="color" id="input-user-color" value="#88C070" />
                  <span class="color-circle-preview" id="user-color-preview" style="background:#88C070"></span>
                  <span class="user-color-text">
                    <strong>自選顏色自動搭配</strong>
                    <small id="user-color-hex" class="tabular-nums">點擊調色 (#88C070)</small>
                  </span>
                </label>

                <button type="button" class="mono-restore-btn is-active" id="btn-restore-mono">
                  <span class="mono-half-icon"></span>
                  <span>無色系 (黑白)</span>
                </button>
              </div>

              <!-- 當前自動配出的 4 階色票預覽 (亦可點擊個別微調) -->
              <div class="tone-strip-box">
                <span class="sub-title">目前色系 4 階深淺（點擊色塊可單獨微調）：</span>
                <div class="tone-squares">
                  {[0, 1, 2, 3].map((idx) => (
                    <label class="tone-item" title={`微調第 ${idx + 1} 階顏色`}>
                      <input type="color" class="tone-single-input" data-tone-idx={idx} value="#000000" />
                      <span class="tone-box" data-tone-box={idx}></span>
                      <code class="tone-code tabular-nums" data-tone-code={idx}>#000000</code>
                    </label>
                  ))}
                </div>
              </div>

              <!-- 經典色系快選 -->
              <div class="preset-colors-section">
                <span class="sub-title">或選擇預設色系：</span>
                <div class="preset-swatches-grid">
                  {PALETTE_PRESETS.map((preset) => (
                    <button
                      type="button"
                      class="preset-swatch-btn"
                      data-preset-palette={JSON.stringify(preset.colors)}
                      data-preset-name={preset.name}
                    >
                      <span class="quad-mini">
                        {preset.colors.map((c) => (
                          <i style={`background:${c}`}></i>
                        ))}
                      </span>
                      <span>{preset.name}</span>
                    </button>
                  ))}
                </div>
              </div>

              <!-- 彩色模式下的膚色深淺與背景樣式切換 -->
              <div class="extra-color-options">
                <div class="option-group">
                  <span class="sub-title">膚色深淺階：</span>
                  <div class="pill-row">
                    <button type="button" class="mini-pill" data-skin-tone="3">淺亮階</button>
                    <button type="button" class="mini-pill is-active" data-skin-tone="2">自然中階</button>
                    <button type="button" class="mini-pill" data-skin-tone="1">深色暗階</button>
                  </div>
                </div>
                <div class="option-group">
                  <span class="sub-title">背景網點：</span>
                  <div class="pill-row">
                    <button type="button" class="mini-pill is-active" data-bg-style="solid-2">中色底</button>
                    <button type="button" class="mini-pill" data-bg-style="solid-3">亮色底</button>
                    <button type="button" class="mini-pill" data-bg-style="solid-1">深色底</button>
                    <button type="button" class="mini-pill" data-bg-style="checker">棋盤格</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 10 個獨立部位選擇器方塊 (對齊 notion-avatar.app 10 格結構，採用 8-Bit 黑灰白像素插槽) -->
      <div class="part-category-bar" role="tablist" aria-label="人物頭像 10 大拆解部位">
        {PART_CATEGORIES.map((cat, idx) => (
          <div class="cat-picker-cell">
            <button
              type="button"
              role="tab"
              class={`cat-box-btn ${idx === 0 ? 'is-active' : ''}`}
              data-cat-key={cat.key}
              aria-selected={idx === 0 ? 'true' : 'false'}
              title={cat.label}
            >
              <canvas
                class="pixel-canvas cat-current-canvas"
                width="84"
                height="84"
                data-cat-summary-canvas={cat.key}
              ></canvas>
            </button>
            <span class="cat-box-label">{cat.label}</span>
          </div>
        ))}
      </div>

      <!-- 當前展開部位的「單獨拆解元素」8-Bit 視窗網格 -->
      <div class="part-options-drawer">
        <div class="drawer-header">
          <div class="drawer-title-group">
            <span class="drawer-pixel-bullet" aria-hidden="true">■</span>
            <span class="drawer-title" id="drawer-category-title">臉型 — 選擇元素搭配</span>
          </div>
          <span class="drawer-coord-note tabular-nums">GRID: 32×32 COORD</span>
        </div>

        {PART_CATEGORIES.map((cat, catIdx) => {
          const items = PART_ITEMS_MAP[cat.key];
          return (
            <div
              class={`isolated-parts-grid ${catIdx === 0 ? 'is-open' : ''}`}
              data-options-grid={cat.key}
              role="tabpanel"
            >
              {items.map((item, itemIdx) => (
                <button
                  type="button"
                  class={`isolated-item-btn ${itemIdx === 0 ? 'is-selected' : ''}`}
                  data-select-cat={cat.key}
                  data-select-idx={itemIdx}
                  title={item.name}
                >
                  <canvas
                    class="pixel-canvas isolated-item-canvas"
                    width="96"
                    height="96"
                    data-isolated-cat={cat.key}
                    data-isolated-idx={itemIdx}
                  ></canvas>
                  <span class="isolated-item-name">{item.name}</span>
                </button>
              ))}
            </div>
          );
        })}
      </div>
    </section>

    <!-- 3. 底部 8-Bit 實體按鍵列 -->
    <section class="action-buttons-row" aria-label="隨機搭配與下載">
      <button type="button" class="pixel-action-btn primary-random-btn" id="btn-destiny-random">
        <svg class="dice-svg" width="22" height="22" viewBox="0 0 16 16" fill="currentColor" shape-rendering="crispEdges">
          <!-- 8-Bit 像素骰子外框 -->
          <rect x="2" y="1" width="12" height="1" />
          <rect x="2" y="14" width="12" height="1" />
          <rect x="1" y="2" width="1" height="12" />
          <rect x="14" y="2" width="1" height="12" />
          <!-- 像素五點 -->
          <rect x="4" y="4" width="2" height="2" />
          <rect x="10" y="4" width="2" height="2" />
          <rect x="7" y="7" width="2" height="2" />
          <rect x="4" y="10" width="2" height="2" />
          <rect x="10" y="10" width="2" height="2" />
        </svg>
        <span>一切交由上天安排</span>
      </button>

      <button type="button" class="pixel-action-btn" id="btn-download-png">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" shape-rendering="crispEdges">
          <!-- 8-Bit 像素下載箭頭 -->
          <rect x="7" y="2" width="2" height="7" />
          <rect x="5" y="7" width="6" height="2" />
          <rect x="6" y="9" width="4" height="1" />
          <rect x="7" y="10" width="2" height="1" />
          <!-- 底部像素托盤 -->
          <rect x="2" y="11" width="2" height="3" />
          <rect x="12" y="11" width="2" height="3" />
          <rect x="4" y="13" width="8" height="1" />
        </svg>
        <span>下載 PNG</span>
      </button>

      <button type="button" class="pixel-action-btn" id="btn-download-svg">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" shape-rendering="crispEdges">
          <!-- 8-Bit 像素程式碼角括號 < > -->
          <rect x="5" y="4" width="2" height="2" />
          <rect x="3" y="6" width="2" height="2" />
          <rect x="2" y="7" width="1" height="2" />
          <rect x="3" y="8" width="2" height="2" />
          <rect x="5" y="10" width="2" height="2" />
          <rect x="9" y="4" width="2" height="2" />
          <rect x="11" y="6" width="2" height="2" />
          <rect x="13" y="7" width="1" height="2" />
          <rect x="11" y="8" width="2" height="2" />
          <rect x="9" y="10" width="2" height="2" />
        </svg>
        <span>下載 SVG</span>
      </button>
    </section>
  </main>
</div>

<script>
  import {
    type AvatarState,
    type BgStyleId,
    type PartCategoryKey,
    type SkinToneLevel,
    PART_CATEGORIES,
    PART_ITEMS_MAP,
  } from '../lib/avatar-data';
  import {
    type ColorMode,
    type FourTonePalette,
    PALETTE_PRESETS,
    generatePaletteFromSeedColor,
  } from '../lib/palettes';
  import {
    renderAvatarToCanvas,
    renderIsolatedPartToCanvas,
    generateAvatarSVG,
    generateRandomAvatarState,
    createDefaultAvatarState,
  } from '../lib/renderer';

  // --- State ---
  // 預設為 'mono' 黑白模式（8-bit_3.jpg 風格）；當使用者選擇顏色時自動切換為 'palette'（8-bit_2.jpg 風格）
  let state: AvatarState = createDefaultAvatarState();
  let colorMode: ColorMode = 'mono';
  let palette: FourTonePalette = [...PALETTE_PRESETS[0].colors] as FourTonePalette;
  let activeColorLabel = '原始黑白模式';
  let activeCategory: PartCategoryKey = 'face';

  const mainCanvas = document.getElementById('main-avatar-canvas') as HTMLCanvasElement | null;
  const headerBadge = document.getElementById('header-color-badge');
  const palettePopover = document.getElementById('palette-popover');
  const btnTogglePalette = document.getElementById('btn-toggle-palette');
  const paletteDot = document.getElementById('palette-dot-indicator');
  const inputUserColor = document.getElementById('input-user-color') as HTMLInputElement | null;
  const userColorPreview = document.getElementById('user-color-preview');
  const userColorHex = document.getElementById('user-color-hex');
  const btnRestoreMono = document.getElementById('btn-restore-mono');
  const drawerTitle = document.getElementById('drawer-category-title');

  function renderAll() {
    // 1. 渲染正中央組合後的大頭照
    if (mainCanvas) {
      renderAvatarToCanvas(mainCanvas, state, colorMode, palette);
    }

    // 2. 渲染 10 個部位分類方塊上的「當前選中單獨元素圖案」
    PART_CATEGORIES.forEach(({ key }) => {
      const summaryCanvas = document.querySelector<HTMLCanvasElement>(
        `canvas[data-cat-summary-canvas="${key}"]`
      );
      if (!summaryCanvas) return;
      const items = PART_ITEMS_MAP[key];
      const selectedIdx = state[key] as number;
      const item = items[selectedIdx] ?? items[0];
      renderIsolatedPartToCanvas(summaryCanvas, item, key, colorMode, palette, state.skinTone);
    });

    // 3. 渲染當前打開分類下的所有「單獨拆解元素」選項縮圖
    const activeGrid = document.querySelector<HTMLElement>(
      `.isolated-parts-grid[data-options-grid="${activeCategory}"]`
    );
    if (activeGrid) {
      const items = PART_ITEMS_MAP[activeCategory];
      activeGrid.querySelectorAll<HTMLCanvasElement>('canvas[data-isolated-idx]').forEach((c) => {
        const idx = Number(c.dataset.isolatedIdx);
        const item = items[idx];
        if (item) {
          renderIsolatedPartToCanvas(c, item, activeCategory, colorMode, palette, state.skinTone);
        }
      });
    }

    // 4. 更新選中狀態外框
    PART_CATEGORIES.forEach(({ key }) => {
      const selectedIdx = state[key] as number;
      document
        .querySelectorAll<HTMLElement>(`.isolated-item-btn[data-select-cat="${key}"]`)
        .forEach((btn) => {
          btn.classList.toggle('is-selected', Number(btn.dataset.selectIdx) === selectedIdx);
        });
    });

    // 5. 更新色系 UI 顯示 (維持全站黑灰白介面配置)
    const isMono = colorMode === 'mono';
    btnRestoreMono?.classList.toggle('is-active', isMono);
    if (headerBadge) {
      headerBadge.textContent = isMono ? 'MODE: 1-BIT 黑白' : `PALETTE: ${activeColorLabel}`;
    }
    if (paletteDot) {
      paletteDot.style.backgroundColor = isMono ? '#141414' : palette[2];
    }

    for (let i = 0; i < 4; i++) {
      const hex = palette[i].toUpperCase();
      const box = document.querySelector<HTMLElement>(`[data-tone-box="${i}"]`);
      const code = document.querySelector<HTMLElement>(`[data-tone-code="${i}"]`);
      const inp = document.querySelector<HTMLInputElement>(`.tone-single-input[data-tone-idx="${i}"]`);
      if (box) box.style.backgroundColor = hex;
      if (code) code.textContent = hex;
      if (inp) inp.value = hex;
    }

    document.querySelectorAll<HTMLElement>('[data-skin-tone]').forEach((btn) => {
      btn.classList.toggle('is-active', Number(btn.dataset.skinTone) === state.skinTone);
    });
    document.querySelectorAll<HTMLElement>('[data-bg-style]').forEach((btn) => {
      btn.classList.toggle('is-active', btn.dataset.bgStyle === state.bgStyle);
    });
  }

  // --- Events ---

  // 切換 10 個部位分類 Tab
  document.querySelectorAll<HTMLButtonElement>('.cat-box-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = (btn.dataset.catKey ?? 'face') as PartCategoryKey;
      activeCategory = key;

      document.querySelectorAll<HTMLButtonElement>('.cat-box-btn').forEach((b) => {
        const active = b.dataset.catKey === key;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });

      document.querySelectorAll<HTMLElement>('.isolated-parts-grid').forEach((grid) => {
        grid.classList.toggle('is-open', grid.dataset.optionsGrid === key);
      });

      const catObj = PART_CATEGORIES.find((c) => c.key === key);
      if (drawerTitle && catObj) {
        drawerTitle.textContent = `${catObj.label} — 選擇拆解元素搭配`;
      }

      renderAll();
    });
  });

  // 點擊某個單獨拆解元素進行穿戴
  document.querySelectorAll<HTMLButtonElement>('.isolated-item-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.selectCat as PartCategoryKey;
      const idx = Number(btn.dataset.selectIdx);
      if (cat) {
        (state as unknown as Record<string, number>)[cat] = idx;
        renderAll();
      }
    });
  });

  // 水平翻轉按鈕
  const btnFlipX = document.getElementById('btn-flip-x');
  btnFlipX?.addEventListener('click', () => {
    state.flipX = !state.flipX;
    btnFlipX.classList.toggle('is-active', state.flipX);
    btnFlipX.setAttribute('aria-pressed', String(state.flipX));
    renderAll();
  });

  // 打開 / 關閉色系調配面板
  btnTogglePalette?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = palettePopover?.classList.toggle('is-hidden');
    btnTogglePalette.setAttribute('aria-expanded', String(!isHidden));
  });

  document.getElementById('btn-close-palette')?.addEventListener('click', () => {
    palettePopover?.classList.add('is-hidden');
    btnTogglePalette?.setAttribute('aria-expanded', 'false');
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (
      palettePopover &&
      !palettePopover.classList.contains('is-hidden') &&
      !palettePopover.contains(target) &&
      !btnTogglePalette?.contains(target)
    ) {
      palettePopover.classList.add('is-hidden');
      btnTogglePalette?.setAttribute('aria-expanded', 'false');
    }
  });

  // 使用者挑選任意顏色 -> 自動推算 4 階深淺並套用色系！
  inputUserColor?.addEventListener('input', () => {
    const hex = inputUserColor.value.toUpperCase();
    palette = generatePaletteFromSeedColor(hex);
    colorMode = 'palette';
    activeColorLabel = `自訂色 ${hex}`;

    if (userColorPreview) userColorPreview.style.backgroundColor = hex;
    if (userColorHex) userColorHex.textContent = `已套用 (${hex})`;
    document.querySelectorAll('.preset-swatch-btn').forEach((b) => b.classList.remove('is-selected'));
    renderAll();
  });

  // 恢復無色系（原始黑白 8-bit_3 模式）
  btnRestoreMono?.addEventListener('click', () => {
    colorMode = 'mono';
    activeColorLabel = '原始黑白模式';
    document.querySelectorAll('.preset-swatch-btn').forEach((b) => b.classList.remove('is-selected'));
    renderAll();
  });

  // 點選預設色系
  document.querySelectorAll<HTMLButtonElement>('.preset-swatch-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const raw = btn.dataset.presetPalette;
      if (!raw) return;
      palette = JSON.parse(raw) as FourTonePalette;
      colorMode = 'palette';
      activeColorLabel = btn.dataset.presetName ?? '預設色系';

      document.querySelectorAll('.preset-swatch-btn').forEach((b) => b.classList.remove('is-selected'));
      btn.classList.add('is-selected');

      if (inputUserColor && userColorPreview && userColorHex) {
        inputUserColor.value = palette[2];
        userColorPreview.style.backgroundColor = palette[2];
        userColorHex.textContent = `點擊調色 (${palette[2]})`;
      }
      renderAll();
    });
  });

  // 個別微調 4 階色塊
  document.querySelectorAll<HTMLInputElement>('.tone-single-input').forEach((inp) => {
    inp.addEventListener('input', () => {
      const idx = Number(inp.dataset.toneIdx);
      if (idx >= 0 && idx < 4) {
        palette[idx] = inp.value.toUpperCase();
        colorMode = 'palette';
        activeColorLabel = '自訂四階微調';
        renderAll();
      }
    });
  });

  // 膚色與背景切換
  document.querySelectorAll<HTMLButtonElement>('[data-skin-tone]').forEach((btn) => {
    btn.addEventListener('click', () => {
      state.skinTone = Number(btn.dataset.skinTone) as SkinToneLevel;
      colorMode = 'palette';
      renderAll();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-bg-style]').forEach((btn) => {
    btn.addEventListener('click', () => {
      state.bgStyle = (btn.dataset.bgStyle ?? 'solid-2') as BgStyleId;
      colorMode = 'palette';
      renderAll();
    });
  });

  // 「一切交由上天安排」隨機按鈕
  let rollInterval: number | null = null;
  document.getElementById('btn-destiny-random')?.addEventListener('click', () => {
    if (rollInterval !== null) window.clearInterval(rollInterval);
    const btn = document.getElementById('btn-destiny-random');
    btn?.classList.add('is-rolling');

    let step = 0;
    rollInterval = window.setInterval(() => {
      step++;
      state = generateRandomAvatarState(state);
      renderAll();
      if (step >= 5) {
        if (rollInterval !== null) window.clearInterval(rollInterval);
        rollInterval = null;
        btn?.classList.remove('is-rolling');
      }
    }, 45);
  });

  // 下載 PNG 與 SVG
  function triggerDownload(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  document.getElementById('btn-download-png')?.addEventListener('click', () => {
    const exportCanvas = document.createElement('canvas');
    exportCanvas.width = 1024;
    exportCanvas.height = 1024;
    renderAvatarToCanvas(exportCanvas, state, colorMode, palette);
    exportCanvas.toBlob((blob) => {
      if (blob) triggerDownload(blob, '8bit-avatar.png');
    }, 'image/png');
  });

  document.getElementById('btn-download-svg')?.addEventListener('click', () => {
    const svg = generateAvatarSVG(state, colorMode, palette);
    const blob = new Blob([svg], { type: 'image/svg+xml;charset=utf-8' });
    triggerDownload(blob, '8bit-avatar.svg');
  });

  // 初始繪製所有元素與畫布
  PART_CATEGORIES.forEach(({ key }) => {
    const grid = document.querySelector<HTMLElement>(`.isolated-parts-grid[data-options-grid="${key}"]`);
    if (!grid) return;
    const items = PART_ITEMS_MAP[key];
    grid.querySelectorAll<HTMLCanvasElement>('canvas[data-isolated-idx]').forEach((c) => {
      const idx = Number(c.dataset.isolatedIdx);
      if (items[idx]) {
        renderIsolatedPartToCanvas(c, items[idx], key, colorMode, palette, state.skinTone);
      }
    });
  });
  renderAll();
</script>

